@model BikerHub.Api.Dtos.BikeListingDto
@{
    ViewData["Title"] = "Shared Listing";
    var primaryImage = Model.Medias?.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m.Url));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg: #f5f5f5;
            --card: #ffffff;
            --card-border: #e5e7eb;
            --text: #111111;
            --muted: #6b7280;
            --accent: #ef5a24;
            --secondary-text: #6b7280;
            --soft-bg: #f3f4f6;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            width: 100%;
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            padding: 0;
            background: var(--bg);
        }

        .page {
            width: 100%;
            max-width: 100%;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 4px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px 6px;
        }

        .card-title {
            flex: 1;
            font-size: 16px;
            font-weight: 700;
            margin: 0 12px 0 0;
            line-height: 1.3;
            color: var(--text);
        }

        .favorite-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .favorite-icon {
            width: 18px;
            height: 18px;
            position: relative;
            display: inline-block;
        }

        .favorite-icon::before {
            content: "♥";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6b7280;
            font-size: 18px;
            line-height: 1;
        }

        .count-text {
            font-size: 13px;
            font-weight: 700;
            color: var(--secondary-text);
        }

        .image-wrap {
            position: relative;
            width: 100%;
        }

        .image-wrap img {
            display: block;
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .sold-badge {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 90px;
            height: 40px;
            background: #ff0000;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-weight: 800;
            letter-spacing: 0.3px;
            font-size: 18px;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 14px;
        }

        .card-price {
            margin: 0;
            color: var(--accent);
            font-size: 13px;
            font-weight: 700;
            line-height: 1.2;
        }

        .seller-row {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .card-seller {
            font-size: 16px;
            color: var(--secondary-text);
        }

        .rating {
            font-size: 12px;
            color: var(--secondary-text);
            font-weight: 700;
        }

        .card-location-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            padding: 0 14px 6px;
        }

        .location-row-left {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--secondary-text);
        }

        .location-icon {
            width: 14px;
            height: 14px;
            position: relative;
            display: inline-block;
        }

        .location-icon::before {
            content: "◉";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary-text);
            font-size: 12px;
        }

        .card-location-text {
            font-size: 13px;
            color: var(--secondary-text);
        }

        .stats-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .like-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .like-icon {
            width: 18px;
            height: 18px;
            position: relative;
            display: inline-block;
        }

        .like-icon::before {
            content: "👍";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: var(--secondary-text);
        }
    </style>
</head>
<body>
    <div class="page">
        <article class="card">
            <div class="card-header">
                <h1 class="card-title">@Model.Make @Model.Model @Model.Cc cc @Model.Edition @Model.Year</h1>
                <div class="favorite-wrapper">
                    <span class="favorite-icon"></span>
                    <span class="count-text">@Model.FavoritesCount</span>
                </div>
            </div>

            @if (primaryImage is not null && !string.IsNullOrWhiteSpace(primaryImage.Url))
            {
                <div class="image-wrap">
                    <img src="@primaryImage.Url" alt="Bike listing" />
                    @if (Model.IsSold)
                    {
                        <div class="sold-badge">SOLD</div>
                    }
                </div>
            }

            <div class="card-footer">
                <p class="card-price">Ks @Model.Price.ToString("N0")</p>
                <div class="seller-row">
                    <span class="card-seller">@Model.SellerName</span>
                    <span class="rating">★ @((Model.Rating > 0) ? Model.Rating.ToString("0.0") : "0.0")</span>
                </div>
            </div>

            <div class="card-location-row">
                <div class="location-row-left">
                    <span class="location-icon"></span>
                    <span class="card-location-text">
                        @Model.SellerCity
                        @if (!string.IsNullOrWhiteSpace(Model.SellerCountry))
                        {
                            <text>, @Model.SellerCountry</text>
                        }
                    </span>
                </div>

                <div class="stats-row">
                    <div class="like-wrapper">
                        <span class="like-icon"></span>
                        <span class="count-text">@Model.LikeCount</span>
                    </div>
                </div>
            </div>
        </article>
    </div>
</body>
</html>
