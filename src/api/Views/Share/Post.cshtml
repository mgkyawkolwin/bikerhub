@model BikerHub.Api.Dtos.SocialPostDto
@{
    ViewData["Title"] = "Shared Post";

    var mediaItems = Model.Medias ?? Enumerable.Empty<BikerHub.Api.Dtos.SocialPostMediaDto>();
    var imageCount = mediaItems.Count();
    var mediaDisplayCount = Math.Min(mediaItems.Count(), 4);
    var extraCount = Math.Max(0, mediaItems.Count() - 4);
}

<style>
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --text: #111111;
        --muted: #666666;
        --accent: #ff3b30;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, Helvetica, sans-serif;
        color: var(--text);
        -webkit-text-size-adjust: 100%;
        overflow-x: hidden;
    }

    .post-card {
        width: 100%;
        max-width: 100%;
        background: var(--card);
        padding: 12px;
        margin: 0;
        overflow: hidden;
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    .post-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .author {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 9999px;
        background: #d9d9d9;
        object-fit: cover;
        display: block;
        flex-shrink: 0;
    }

    .meta {
        min-width: 0;
        flex: 1 1 auto;
    }

    .author-name {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.2;
        color: var(--text);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        color: var(--muted);
        font-size: 12px;
    }

    .schedule-icon {
        width: 12px;
        height: 12px;
        display: inline-block;
        border-radius: 2px;
        background: linear-gradient(135deg, #777, #a3a3a3);
        position: relative;
        flex-shrink: 0;
    }
    .schedule-icon::before {
        content: "";
        position: absolute;
        left: 50%; top: 50%;
        width: 1px; height: 6px;
        background: white;
        transform: translate(-50%, -50%);
        border-radius: 1px;
    }
    .schedule-icon::after {
        content: "";
        position: absolute;
        left: 50%; top: 50%;
        width: 4px; height: 1px;
        background: white;
        transform: translate(-50%, -50%);
        border-radius: 1px;
    }

    .menu {
        width: 24px;
        height: 24px;
        position: relative;
        flex-shrink: 0;
    }
    .menu::before,
    .menu::after,
    .menu span {
        content: "";
        position: absolute;
        left: 50%;
        width: 4px; height: 4px;
        border-radius: 50%;
        background: var(--text);
        transform: translateX(-50%);
    }
    .menu::before { top: 2px; }
    .menu span   { top: 10px; }
    .menu::after { top: 18px; }

    .content {
        margin: 6px 0 12px;
        font-size: 15px;
        line-height: 22px;
        color: var(--text);
        white-space: pre-wrap;
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }

    /* Use CSS grid — it handles arbitrary child counts without overflow */
    .media-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin: 0 0 12px;
        width: 100%;
    }

    .media-tile {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 12px;
        background: #222;
    }

    .media-tile.single {
        grid-column: 1 / -1;
        aspect-ratio: auto;
        max-height: 320px;
    }
    .media-tile.single img,
    .media-tile.single video {
        max-height: 320px;
        object-fit: cover;
    }

    .media-tile img,
    .media-tile video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        background: #222;
    }

    .more-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        color: white;
        font-size: 24px;
        font-weight: 800;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 8px;
        border-top: 1px solid rgba(0,0,0,0.04);
    }

    .action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1;
    }

    .icon {
        width: 18px;
        height: 18px;
        display: inline-block;
        border-radius: 4px;
        position: relative;
        background: transparent;
    }
    .icon.heart::before {
        content: "♥";
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; line-height: 1;
        color: var(--muted);
    }
    .icon.comment::before {
        content: "💬";
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px; line-height: 1;
    }
    .icon.share::before {
        content: "↗";
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; line-height: 1;
    }

    .share-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        padding: 8px 12px;
    }
</style>

<article class="post-card">
    <header class="post-header">
        <div class="author">
            @if (!string.IsNullOrWhiteSpace(Model.CreatedByUserProfilePhotoUrl))
            {
                <img class="avatar" src="@Model.CreatedByUserProfilePhotoUrl" alt="@Model.CreatedByDisplayName" />
            }
            else
            {
                <div class="avatar" aria-label="@Model.CreatedByDisplayName"></div>
            }
            <div class="meta">
                <p class="author-name">@Model.CreatedByDisplayName</p>
                <div class="meta-row">
                    <span class="schedule-icon" aria-hidden="true"></span>
                    <span>@Model.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>
        <div class="menu" aria-label="More options"><span></span></div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Content))
    {
        <div class="content">@Model.Content</div>
    }

    @if (mediaItems.Any())
    {
        <div class="media-grid">
            @for (var i = 0; i < mediaDisplayCount; i++)
            {
                var item = mediaItems.ElementAt(i);
                var isVideo = !string.IsNullOrWhiteSpace(item.ContentType) && item.ContentType.StartsWith("video/");
                var isLast = i == 3 && extraCount > 0;
                var cssClass = mediaItems.Count() == 1 ? "media-tile single" : "media-tile";

                <div class="@cssClass">
                    @if (isVideo)
                    {
                        <video controls playsinline preload="metadata" muted>
                            <source src="@item.Url" type="@item.ContentType" />
                        </video>
                    }
                    else
                    {
                        <img src="@item.Url" alt="Post media" />
                    }

                    @if (isLast)
                    {
                        <div class="more-overlay">+@extraCount</div>
                    }
                </div>
            }
        </div>
    }

    <div class="actions">
        <div class="action">
            <span class="icon heart" aria-hidden="true"></span>
            <span>@Model.LoveCount</span>
        </div>
        <div class="action">
            <span class="icon comment" aria-hidden="true"></span>
            <span>@Model.CommentCount</span>
        </div>
        <div class="share-box">
            <span class="icon share" aria-hidden="true"></span>
            <span>Share</span>
        </div>
    </div>
</article>