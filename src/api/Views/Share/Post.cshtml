@model BikerHub.Api.Dtos.SocialPostDto
@{
    ViewData["Title"] = "Shared Post";

    var mediaItems = Model.Medias ?? Enumerable.Empty<BikerHub.Api.Dtos.SocialPostMediaDto>();
    var firstImage = mediaItems.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m.Url) && !m.ContentType.StartsWith("video/"));
    var imageCount = mediaItems.Count();
    var mediaDisplayCount = Math.Min(mediaItems.Count(), 4);
    var extraCount = Math.Max(0, mediaItems.Count() - 4);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg: #f4f4f4;
            --card: #ffffff;
            --card-border: #e5e5e5;
            --text: #111111;
            --muted: #666666;
            --muted-soft: #8d8d8d;
            --shadow: rgba(0, 0, 0, 0.08);
            --accent: #ff3b30;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            width: 100%;
            padding: 0;
        }

        .post-card {
            width: 100%;
            min-height: 100vh;
            background: var(--card);
            border: none;
            border-radius: 0;
            box-shadow: none;
            overflow: hidden;
            padding: 12px;
        }

        .post-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
        }

        .author {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
            min-width: 0;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 9999px;
            background: #d9d9d9;
            object-fit: cover;
            display: block;
        }

        .meta {
            min-width: 0;
            flex: 1;
        }

        .author-name {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text);
        }

        .meta-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
        }

        .schedule-icon {
            width: 12px;
            height: 12px;
            display: inline-block;
            border-radius: 2px;
            background: linear-gradient(135deg, #777, #a3a3a3);
            position: relative;
            flex-shrink: 0;
        }

        .schedule-icon::before {
            content: "";
            position: absolute;
            left: 50%;
            top: 50%;
            width: 1px;
            height: 6px;
            background: white;
            transform: translate(-50%, -50%);
            border-radius: 1px;
        }

        .schedule-icon::after {
            content: "";
            position: absolute;
            left: 50%;
            top: 50%;
            width: 4px;
            height: 1px;
            background: white;
            transform: translate(-50%, -50%);
            border-radius: 1px;
        }

        .menu {
            width: 24px;
            height: 24px;
            position: relative;
            flex-shrink: 0;
        }

        .menu::before,
        .menu::after,
        .menu span {
            content: "";
            position: absolute;
            left: 50%;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--text);
            transform: translateX(-50%);
        }

        .menu::before { top: 2px; }
        .menu span { top: 10px; }
        .menu::after { top: 18px; }

        .content {
            margin: 6px 0 12px;
            font-size: 15px;
            line-height: 22px;
            color: var(--text);
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .media-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 12px;
        }

        .media-tile {
            position: relative;
            width: 48%;
            aspect-ratio: 1;
            overflow: hidden;
            border-radius: 12px;
            background: #222;
        }

        .media-tile.single {
            width: 100%;
            aspect-ratio: auto;
            height: 200px;
        }

        .media-tile img,
        .media-tile video {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            background: #222;
        }

        .more-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.45);
            color: white;
            font-size: 24px;
            font-weight: 800;
        }

        .actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: 8px;
            border-top: 1px solid rgba(0,0,0,0.04);
        }

        .action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1;
        }

        .icon {
            width: 18px;
            height: 18px;
            display: inline-block;
            border-radius: 4px;
            position: relative;
            background: transparent;
        }

        .icon.heart::before {
            content: "♥";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            line-height: 1;
            color: var(--muted);
        }

        .icon.comment::before {
            content: "💬";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            line-height: 1;
        }

        .icon.share::before {
            content: "↗";
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            line-height: 1;
        }

        .share-box {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            padding: 8px 12px;
        }
    </style>
</head>
<body>
    <article class="post-card">
        <header class="post-header">
            <div class="author">
                @if (!string.IsNullOrWhiteSpace(Model.CreatedByUserProfilePhotoUrl))
                {
                    <img class="avatar" src="@Model.CreatedByUserProfilePhotoUrl" alt="@Model.CreatedByDisplayName" />
                }
                else
                {
                    <div class="avatar" aria-label="@Model.CreatedByDisplayName"></div>
                }
                <div class="meta">
                    <p class="author-name">@Model.CreatedByDisplayName</p>
                    <div class="meta-row">
                        <span class="schedule-icon" aria-hidden="true"></span>
                        <span>@Model.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
            </div>
            <div class="menu" aria-label="More options"></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <div class="content">@Model.Content</div>
        }

        @if (mediaItems.Any())
        {
            <div class="media-grid">
                @for (var i = 0; i < mediaDisplayCount; i++)
                {
                    var item = mediaItems.ElementAt(i);
                    var isVideo = !string.IsNullOrWhiteSpace(item.ContentType) && item.ContentType.StartsWith("video/");
                    var isLast = i == 3 && extraCount > 0;
                    var cssClass = mediaItems.Count() == 1 ? "media-tile single" : "media-tile";

                    <div class="@cssClass">
                        @if (isVideo)
                        {
                            <video controls playsinline preload="metadata" muted>
                                <source src="@item.Url" type="@item.ContentType" />
                            </video>
                        }
                        else
                        {
                            <img src="@item.Url" alt="Post media" />
                        }

                        @if (isLast)
                        {
                            <div class="more-overlay">+@extraCount</div>
                        }
                    </div>
                }
            </div>
        }

        <div class="actions">
            <div class="action">
                <span class="icon heart" aria-hidden="true"></span>
                <span>@Model.LoveCount</span>
            </div>
            <div class="action">
                <span class="icon comment" aria-hidden="true"></span>
                <span>@Model.CommentCount</span>
            </div>
            <div class="share-box">
                <span class="icon share" aria-hidden="true"></span>
                <span>Share</span>
            </div>
        </div>
    </article>
</body>
</html>
