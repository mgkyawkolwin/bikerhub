@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.FluentUI.AspNetCore.Components
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<div class="page">

    <FluentLayout style="flex:1;" NavMenuTitle="Navigation menu">
        <FluentHeader style="display: flex; align-items: center; gap: 1rem; padding: 0 1rem;">
            <TopBar />
        </FluentHeader>
        
        <FluentStack style="flex: 1;" Orientation="Orientation.Horizontal" Width="100%" Height="100%">
            <NavMenu />
            <FluentBodyContent>
                <div class="main">
                    @Body
                </div>
            </FluentBodyContent>
        </FluentStack>

        <FooterBar />
    </FluentLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
     private string SelectedThemeString { get; set; } = DesignThemeModes.Light.ToString();
    private DesignThemeModes Mode { get; set; } = DesignThemeModes.Light;
    private OfficeColor? OfficeColor { get; set; }

    private void OnThemeChanged()
    {
        if (Enum.TryParse<DesignThemeModes>(SelectedThemeString, out var parsedMode))
        {
            Mode = parsedMode;
        }
    }
    bool ShowHeader = true;
    bool ShowNavMenu = true;
    bool ShowBodyContent = true;
    bool ShowFooter = true;
    private bool isSidebarOpen = true;

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private async Task SignOutAsync()
    {
        if (HttpContextAccessor.HttpContext is not null)
        {
            await HttpContextAccessor.HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }

        Navigation.NavigateTo("/auth/signin", forceLoad: true);
    }
}