@page "/blogs/list"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@using BikerHub.Api.Dtos
@using BikerHub.Api.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBlogService BlogService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject ILogger<List> Logger

<PageTitle>Blogs</PageTitle>

@if (_isCheckingAuth)
{
    <div class="p-4">Checking authentication...</div>
    return;
}

@if (!_isAuthenticated)
{
    return;
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Blogs</h2>
        <button type="button" class="btn btn-primary" @onclick="NavigateToNewBlogPage">New Blog</button>
    </div>

    <FluentCard>
        <FluentDataGrid @ref="_blogGrid"
                        TGridItem="BlogDto"
                        ItemsProvider="LoadPageAsync"
                        ItemKey="@(blog => blog.Id)"
                        Pagination="_paginationState"
                        ShowHover="true"
                        DisplayMode="DataGridDisplayMode.Table"
                        GridTemplateColumns="220px 2fr 1fr 1fr 220px">
            <TemplateColumn Title="#">
                <ChildContent Context="blog">
                    <div class="d-flex align-items-center gap-2">
                        <span>@($"{blog.Id.ToString()[..4]}...{blog.Id.ToString()[^4..]}")</span>
                        <FluentIcon Icon="Icons.Regular.Size20.Copy" OnClick="() => CopyIdToClipboard(blog.Id)" />
                    </div>
                </ChildContent>
            </TemplateColumn>
            <PropertyColumn Title="Title" Property="@(blog => blog.Title)" />
            <PropertyColumn Title="Type" Property="@(blog => blog.PostType)" />
            <TemplateColumn Title="Cover">
                <ChildContent Context="blog">
                    @if (!string.IsNullOrWhiteSpace(blog.CoverImageUrl))
                    {
                        <img src="@blog.CoverImageUrl" alt="Cover image" style="width: 72px; height: 48px; object-fit: cover; border-radius: 6px;" />
                    }
                    else
                    {
                        <span class="text-muted">No cover</span>
                    }
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Created">
                <ChildContent Context="blog">
                    <span>@(blog.CreatedAtUTC?.ToString("yyyy-MM-dd") ?? "-")</span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <ChildContent Context="blog">
                    <div class="d-flex gap-2">
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@_editIcon" OnClick="() => OpenEditBlogDialog(blog)">
                            <span class="visually-hidden">Edit</span>
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@_deleteIcon" OnClick="() => ConfirmDeleteBlogAsync(blog)">
                            <span class="visually-hidden">Delete</span>
                        </FluentButton>
                    </div>
                </ChildContent>
            </TemplateColumn>
        </FluentDataGrid>

        <div class="mt-3">
            <FluentPaginator State="_paginationState" />
        </div>
    </FluentCard>


    <FluentDialog @bind-Hidden="_isEditBlogDialogHidden" Modal="true" TrapFocus="true" AriaLabel="Edit blog">
        <div class="p-4" style="min-width: 520px;">
            <h4>Edit blog</h4>

            <EditForm Model="_editBlog" OnValidSubmit="UpdateBlogAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <FluentTextField @bind-Value="_editBlog.Title" Placeholder="Blog title" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Content</label>
                    <FluentTextArea @bind-Value="_editBlog.Content" Placeholder="Blog content" Style="width: 100%; min-height: 140px;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Cover Image URL</label>
                    <FluentTextField @bind-Value="_editBlog.CoverImageUrl" Placeholder="Cover image URL" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Post Type</label>
                    <FluentTextField @bind-Value="_editBlog.PostType" Placeholder="Post type" Style="width: 100%;" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_formErrorMessage))
                {
                    <div class="alert alert-danger">@_formErrorMessage</div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditBlogDialog">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="_isSubmitting">
                        @(_isSubmitting ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </FluentDialog>
</div>

@code {
    private bool _isCheckingAuth = true;
    private bool _isAuthenticated;
    private List<BlogDto> _blogs = new();
    private FluentDataGrid<BlogDto>? _blogGrid;
    private readonly PaginationState _paginationState = new() { ItemsPerPage = 10 };
    private bool _isEditBlogDialogHidden = true;
    private bool _isSubmitting;
    private string? _formErrorMessage;
    private BlogModel _editBlog = new();
    private Guid _editingBlogId;
    private readonly Icon _editIcon = new Icon("Edit", IconVariant.Regular, IconSize.Size16, "Edit");
    private readonly Icon _deleteIcon = new Icon("Delete", IconVariant.Regular, IconSize.Size16, "Delete");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        if (!_isAuthenticated)
        {
            Navigation.NavigateTo("/auth/signin", replace: true);
            return;
        }

        _isCheckingAuth = false;
    }

    private async ValueTask<GridItemsProviderResult<BlogDto>> LoadPageAsync(GridItemsProviderRequest<BlogDto> request)
    {
        try
        {
            var pageSize = request.Count ?? _paginationState.ItemsPerPage;
            var page = (request.StartIndex / pageSize) + 1;
            var result = await BlogService.GetBlogsAsync(page, pageSize);
            _blogs = result.Items.ToList();
            return GridItemsProviderResult.From(_blogs, result.Total);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load blogs.");
            return GridItemsProviderResult.From(Array.Empty<BlogDto>(), 0);
        }
    }

    private void NavigateToNewBlogPage()
    {
        Navigation.NavigateTo("/blogs/new");
    }

    private void OpenEditBlogDialog(BlogDto blog)
    {
        _formErrorMessage = null;
        _editingBlogId = blog.Id;
        _editBlog = new BlogModel
        {
                Title = blog.Title,
                Content = blog.Content,
                CoverImageUrl = blog.CoverImageUrl,
                PostType = blog.PostType.ToString()
            };
            _isEditBlogDialogHidden = false;
        }
                }

                _isSubmitting = true;
                try
                {
                    var deleted = await BlogService.DeleteBlogAsync(blog.Id);
                    if (deleted && _blogGrid is not null)
                    {
                        await _blogGrid.RefreshDataAsync(false);
                    }

                    ToastService.ShowSuccess("Blog deleted successfully.", 2000, "Deleted");
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to delete blog.");
                    ToastService.ShowError("Failed to delete blog.", 2000, "Error");
                }
                finally
                {
                    _isSubmitting = false;
                }
            },
            $"Are you sure you want to delete blog '{blog.Title}'?",
            "Delete",
            "Cancel",
            "Confirm delete");
    }


    private async Task UpdateBlogAsync()
    {
        _formErrorMessage = null;
        _isSubmitting = true;

        try
        {
            var dto = new UpdateBlogDto(
                _editBlog.Title,
                _editBlog.Content,
                _editBlog.CoverImageUrl,
                Enum.TryParse<BlogPostType>(_editBlog.PostType, true, out var postType) ? postType : null);

            var updatedBlog = await BlogService.UpdateBlogAsync(_editingBlogId, dto);
            if (updatedBlog is null)
            {
                _formErrorMessage = "Blog not found.";
                return;
            }

            if (_blogGrid is not null)
            {
                await _blogGrid.RefreshDataAsync(false);
            }

            _isEditBlogDialogHidden = true;
            ToastService.ShowSuccess("Blog updated successfully.", 2000, "Success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update blog.");
            _formErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CopyIdToClipboard(Guid id)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", id.ToString());
        ToastService.ShowSuccess("Blog ID copied to clipboard.", 1500, "Copied");
    }

    private sealed class BlogModel
    {
        [Required(ErrorMessage = "Title is required")]
        public string Title { get; set; } = string.Empty;

        public string? Content { get; set; }

        public string? CoverImageUrl { get; set; }

        public string PostType { get; set; } = BlogPostType.General.ToString();
    }
}
