@page "/users/list"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using BikerHub.Dtos
@using BikerHub.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService UserService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject ILogger<List> Logger
@inject IStringLocalizer<LocalizedStrings> Localizer

<PageTitle>Users</PageTitle>

@if (_isCheckingAuth)
{
    <div class="p-4">Checking authentication...</div>
    return;
}

@if (!_isAuthenticated)
{
    return;
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Users</h2>
        <button type="button" class="btn btn-primary" @onclick="OpenNewUserDialog">New User</button>
    </div>

    <FluentCard>
        <FluentDataGrid @ref="_userGrid" TGridItem="UserDto" ItemsProvider="LoadPageAsync" ItemKey="@(user => user.Id)" Pagination="_paginationState" ShowHover="true" DisplayMode="DataGridDisplayMode.Table" GridTemplateColumns="200px 1fr 1.5fr 1fr 180px 180px">
            <TemplateColumn Title="#">
                <ChildContent Context="user">
                    <div class="d-flex align-items-center gap-2">
                        <span>@($"{user.Id.ToString()[..4]}...{user.Id.ToString()[^4..]}")</span>
                        <FluentIcon Icon="Icons.Regular.Size20.Copy" OnClick="() => CopyIdToClipboard(user.Id)" />
                    </div>
                </ChildContent>
            </TemplateColumn>
            <PropertyColumn Title="Username" Property="@(user => user.UserName)" />
            <PropertyColumn Title="Email" Property="@(user => user.Email)" />
            <PropertyColumn Title="City" Property="@(user => user.City)" />
            <TemplateColumn Title="Rating">
                <ChildContent Context="user">
                    <span>@(user.Rating?.ToString("0.0") ?? "-")</span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <ChildContent Context="user">
                    <div class="d-flex gap-2">
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@_editIcon" OnClick="() => OpenEditUserDialog(user)">
                            <span class="visually-hidden">@Localizer["Title.Edit"]</span>
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@_deleteIcon" OnClick="() => ConfirmDeleteUserAsync(user)">
                            <span class="visually-hidden">@Localizer["Title.Delete"]</span>
                        </FluentButton>
                    </div>
                </ChildContent>
            </TemplateColumn>
        </FluentDataGrid>
        <div class="mt-3">
            <FluentPaginator State="_paginationState" />
        </div>
    </FluentCard>

    <FluentDialog @bind-Hidden="_isNewUserDialogHidden" Modal="true" TrapFocus="true" AriaLabel="Create new user">
        <div class="p-4" style="min-width: 420px;">
            <h4>Create new user</h4>

            <EditForm Model="_newUser" OnValidSubmit="CreateNewUserAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <FluentTextField @bind-Value="_newUser.UserName" Placeholder="Username" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Display Name</label>
                    <FluentTextField @bind-Value="_newUser.DisplayName" Placeholder="Display name" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <FluentTextField @bind-Value="_newUser.Email" Placeholder="Email address" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <FluentTextField @bind-Value="_newUser.Password" TextFieldType="TextFieldType.Password" Placeholder="Password" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">City</label>
                    <FluentTextField @bind-Value="_newUser.City" Placeholder="City" Style="width: 100%;" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_formErrorMessage))
                {
                    <div class="alert alert-danger">@_formErrorMessage</div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="CloseNewUserDialog">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Saving..." : "Create User")
                    </button>
                </div>
            </EditForm>
        </div>
    </FluentDialog>

    <FluentDialog @bind-Hidden="_isEditUserDialogHidden" Modal="true" TrapFocus="true" AriaLabel="Edit user">
        <div class="p-4" style="min-width: 420px;">
            <h4>Edit user</h4>

            <EditForm Model="_editUser" OnValidSubmit="UpdateUserAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <FluentTextField @bind-Value="_editUser.UserName" Placeholder="Username" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Display Name</label>
                    <FluentTextField @bind-Value="_editUser.DisplayName" Placeholder="Display name" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <FluentTextField @bind-Value="_editUser.Email" Placeholder="Email address" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <FluentTextField @bind-Value="_editUser.Password" TextFieldType="TextFieldType.Password" Placeholder="Leave blank to keep current password" Style="width: 100%;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">City</label>
                    <FluentTextField @bind-Value="_editUser.City" Placeholder="City" Style="width: 100%;" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_formErrorMessage))
                {
                    <div class="alert alert-danger">@_formErrorMessage</div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditUserDialog">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </FluentDialog>
</div>

@code {
    private bool _isCheckingAuth = true;
    private bool _isAuthenticated;
    private List<UserDto> _users = new();
    private FluentDataGrid<UserDto>? _userGrid;
    private readonly PaginationState _paginationState = new PaginationState { ItemsPerPage = 10 };
    private bool _isNewUserDialogHidden = true;
    private bool _isEditUserDialogHidden = true;
    private bool _isSubmitting;
    private string? _formErrorMessage;
    private NewUserModel _newUser = new();
    private EditUserModel _editUser = new();
    private Guid _editingUserId;
    private readonly Icon _editIcon = new Icon("Edit", IconVariant.Regular, IconSize.Size16, "Edit");
    private readonly Icon _deleteIcon = new Icon("Delete", IconVariant.Regular, IconSize.Size16, "Delete");


    private async Task CopyIdToClipboard(Guid userId)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", userId.ToString());
        ToastService.ShowSuccess("User ID copied to clipboard.", 1500, "Copied");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        if (!_isAuthenticated)
        {
            Navigation.NavigateTo("/auth/signin", replace: true);
            return;
        }

        _isCheckingAuth = false;
    }

    private async ValueTask<GridItemsProviderResult<UserDto>> LoadPageAsync(GridItemsProviderRequest<UserDto> request)
    {
        try
        {
            var startIndex = request.StartIndex;
            var pageSize = request.Count ?? _paginationState.ItemsPerPage;
            var page = (startIndex / pageSize) + 1;

            var result = await UserService.GetUsersAsync(page, pageSize, string.Empty);
            _users = result.Items.ToList();
            return GridItemsProviderResult.From(_users, result.Total);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users.");
            return GridItemsProviderResult.From(Array.Empty<UserDto>(), 0);
        }
    }

    private void OpenNewUserDialog()
    {
        _formErrorMessage = null;
        _newUser = new NewUserModel();
        _isNewUserDialogHidden = false;
    }

    private void CloseNewUserDialog()
    {
        _isNewUserDialogHidden = true;
    }

    private void OpenEditUserDialog(UserDto user)
    {
        _formErrorMessage = null;
        _editingUserId = user.Id;
        _editUser = new EditUserModel
        {
            UserName = user.UserName ?? string.Empty,
            DisplayName = user.DisplayName ?? string.Empty,
            Email = user.Email ?? string.Empty,
            City = user.City,
            Password = string.Empty
        };
        _isEditUserDialogHidden = false;
    }

    private void CloseEditUserDialog()
    {
        _isEditUserDialogHidden = true;
    }

    private async Task ConfirmDeleteUserAsync(UserDto user)
    {
        await DialogService.ShowConfirmationAsync(
            this,
            async dialogResult =>
            {
                if (dialogResult.Cancelled)
                {
                    return;
                }

                _isSubmitting = true;
                try
                {
                    var deleted = await UserService.DeleteAsync(user.Id);
                    if (deleted)
                    {
                        if (_userGrid is not null)
                        {
                            await _userGrid.RefreshDataAsync(false);
                        }
                        ToastService.ShowSuccess("User deleted successfully.", 2000, "Deleted");
                    }
                    else
                    {
                        ToastService.ShowError("Failed to delete user.", 2000, "Error");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to delete user.");
                    ToastService.ShowError("Failed to delete user.", 2000, "Error");
                }
                finally
                {
                    _isSubmitting = false;
                }
            },
            $"Are you sure you want to delete user '{user.UserName ?? user.DisplayName}'?",
            "Delete",
            "Cancel",
            "Confirm delete");
    }

    private async Task CreateNewUserAsync()
    {
        _formErrorMessage = null;
        _isSubmitting = true;

        try
        {
            var dto = new CreateUserDto
            {
                UserName = _newUser.UserName,
                DisplayName = _newUser.DisplayName,
                Email = _newUser.Email,
                Password = _newUser.Password,
                City = _newUser.City
            };

            await UserService.CreateAsync(dto);
            if (_userGrid is not null)
            {
                await _userGrid.RefreshDataAsync(false);
            }

            _isNewUserDialogHidden = true;
            ToastService.ShowSuccess("New user has been created.", 2000, "Success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create new user.");
            _formErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateUserAsync()
    {
        _formErrorMessage = null;
        _isSubmitting = true;

        try
        {
            var dto = new UpdateUserDto
            {
                UserName = _editUser.UserName,
                DisplayName = _editUser.DisplayName,
                Email = _editUser.Email,
                Password = string.IsNullOrWhiteSpace(_editUser.Password) ? null : _editUser.Password,
                City = _editUser.City
            };

            await UserService.UpdateAsync(_editingUserId, dto);
            if (_userGrid is not null)
            {
                await _userGrid.RefreshDataAsync(false);
            }

            _isEditUserDialogHidden = true;
            ToastService.ShowSuccess("User updated successfully.", 2000, "Success");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update user.");
            _formErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ViewUserDetails(UserDto user)
    {
        ToastService.ShowInfo($"Viewing user {user.UserName ?? user.DisplayName}", 2000, "User Details");
    }

    private sealed class NewUserModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Display name is required")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public string? City { get; set; }
    }

    private sealed class EditUserModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Display name is required")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        public string? Password { get; set; }

        public string? City { get; set; }
    }
}
